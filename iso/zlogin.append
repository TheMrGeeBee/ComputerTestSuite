# ComputerTestSuite: pick the keyboard layout (once per boot), then open the
# terminal interface. cts.autorun=<profile> on the kernel command line starts
# that profile automatically. Quitting the interface leaves you in this shell.
if [[ $(tty) == /dev/tty1 ]] && command -v cts >/dev/null; then
    cts-keymap --auto
    if [[ ! -e /run/cts-ui.started ]]; then
        : > /run/cts-ui.started
        cts ui --boot
    fi
fi
