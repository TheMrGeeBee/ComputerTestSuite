# ComputerTestSuite: pick the keyboard layout (once per boot), then
# auto-start a profile when booted with cts.autorun=<profile>
if [[ $(tty) == /dev/tty1 ]] && command -v cts >/dev/null; then
    cts-keymap --auto
    cts autorun
fi
